SELECT FULL_NAME,  PARTNER_NAME, EMAIL
,USER_ACTIVE , SALESPERSON_DEACTIVATION_DATE, PI_STAFF_SUSPENSION_DATE, PI_STAFF_SUSPENSION_REASON ,
CASE WHEN SALESPERSON_DEACTIVATION_DATE IS NULL AND PI_STAFF_SUSPENSION_DATE IS NULL AND user_active = 'TRUE' THEN 'ACTIVE' ELSE 'DEACTIVATED/SUSPENDED' END AS IS_ACTIVE
FROM  PRD_BI.LOS.RPT_SALES_REPS_V 
WHERE SALESPERSON_DEACTIVATION_DATE IS NOT NULL OR PI_STAFF_SUSPENSION_DATE IS NOT NULL 
