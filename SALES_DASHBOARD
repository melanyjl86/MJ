WITH MTD AS(
select partner_name, PI_ORG_STATUS
, AVG(highest_fico_score) as MTD_FICO
, COUNT(CASE WHEN highest_fico_score <680 THEN 1 END) MTD_FICO_680
, AVG(LOAN_AMOUNT) AS MTD_avg_contract_amount
, COUNT(APPLICATION_ID) AS MTD_volume
, COUNT( CASE WHEN PAYMENT_OPTION = 'ACH' THEN 1 END) as MTD_ACH_POS
, AVG((LOAN_AMOUNT/(SYSTEM_SIZE*1000))) as MTD_ppw
, AVG(CASE WHEN TABLE_NAME = 'TPO' AND NOTICE_TO_PROCEED_TIMESTAMP IS NULL THEN DATEDIFF('DAY',ORIGINAL_CONTRACT_SIGNED_DATE, CURRENT_DATE()) END  ) AS MTD_DURATION_CONTRACT_TO_NTP
FROM  PRD_BI.LOS.rpt_executive_v 
WHERE contract_active = 'TRUE'
AND CURRENT_STATUS NOT IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
AND CONTRACT_SIGNED_DATE IS NOT NULL
and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
AND ORIGINAL_CONTRACT_SIGNED_DATE >= DATE_TRUNC('month',CURRENT_DATE()) 
--AND PARTNER_NAME LIKE 'Our World Energy'
GROUP BY PARTNER_NAME, PI_ORG_STATUS
)
, prev_month AS (
select partner_name, PI_ORG_STATUS
, AVG(highest_fico_score) as PREV_MONTH_FICO
, COUNT(CASE WHEN highest_fico_score <680 THEN 1 END) PREV_MONTH_FICO_680
, AVG(LOAN_AMOUNT) AS PREV_MONTH_avg_contract_amount
, COUNT(APPLICATION_ID) AS PREV_MONTH_volume
, COUNT( CASE WHEN PAYMENT_OPTION = 'ACH' THEN 1 END) as PREV_MONTH_ACH_POS
, AVG((LOAN_AMOUNT/(SYSTEM_SIZE*1000))) as PREV_MONTH_ppw
, AVG(CASE WHEN TABLE_NAME = 'TPO' AND (NOTICE_TO_PROCEED_TIMESTAMP IS NULL OR NOTICE_TO_PROCEED_TIMESTAMP >= DATE_TRUNC('month',CURRENT_DATE()) ) THEN DATEDIFF('DAY',ORIGINAL_CONTRACT_SIGNED_DATE, DATE_TRUNC('month',CURRENT_DATE())) END  ) AS PREV_MONTH_DURATION_CONTRACT_TO_NTP
FROM  PRD_BI.LOS.rpt_executive_v 
WHERE contract_active = 'TRUE'
AND CURRENT_STATUS NOT IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
AND CONTRACT_SIGNED_DATE IS NOT NULL 
AND CONTRACT_SIGNED_DATE < DATE_TRUNC('month',CURRENT_DATE())
AND CONTRACT_SIGNED_DATE >= DATEADD('month',-1, DATE_TRUNC('month', CURRENT_DATE()))
and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
GROUP BY PARTNER_NAME, PI_ORG_STATUS

)
, Cancellation_MTD AS(
select partner_name
,COUNT(CASE WHEN PROJECT_CANCELLED_TIMESTAMP IS NOT NULL 
AND CURRENT_STATUS IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
THEN 1 END) AS MTD_num_cancelled
, COUNT(APPLICATION_ID) AS MTD_Total_volume
FROM  PRD_BI.LOS.rpt_executive_v
WHERE contract_active = 'TRUE'
AND CONTRACT_SIGNED_DATE IS NOT NULL 
AND ORIGINAL_CONTRACT_SIGNED_DATE >= DATE_TRUNC('month',CURRENT_DATE()) 
--and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
GROUP BY PARTNER_NAME
)
, Cancellation_prev_Month AS(
select partner_name
,COUNT(CASE WHEN PROJECT_CANCELLED_TIMESTAMP IS NOT NULL 
AND CURRENT_STATUS IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
THEN 1 END
AND  project_cancelled_latest_timestamp < DATE_TRUNC('month',CURRENT_DATE())
AND project_cancelled_latest_timestamp  >= DATEADD('month',-1, DATE_TRUNC('month', CURRENT_DATE()))
) AS PREV_MONTH_num_cancelled
, COUNT(APPLICATION_ID) AS PREV_MONTH_Total_volume
FROM  PRD_BI.LOS.rpt_executive_v 
WHERE contract_active = 'TRUE'
AND CONTRACT_SIGNED_DATE IS NOT NULL 
AND CONTRACT_SIGNED_DATE < DATE_TRUNC('month',CURRENT_DATE())
AND CONTRACT_SIGNED_DATE >= DATEADD('month',-1, DATE_TRUNC('month', CURRENT_DATE()))
--and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
GROUP BY PARTNER_NAME
)
, THREE_MONTH_AGO AS(
select partner_name
, AVG(highest_fico_score) as THREE_MONTH_AGO_FICO
, COUNT(CASE WHEN highest_fico_score <680 THEN 1 END) THREE_MONTH_AGO_FICO_680
, AVG(LOAN_AMOUNT) AS THREE_MONTH_AGO_avg_contract_amount
, COUNT(APPLICATION_ID) AS THREE_MONTH_AGO_VOLUME
, COUNT( CASE WHEN PAYMENT_OPTION = 'ACH' THEN 1 END) as THREE_MONTH_AGO_ACH_POS
, AVG((LOAN_AMOUNT/(SYSTEM_SIZE*1000))) as THREE_MONTH_AGO_ppw
FROM  PRD_BI.LOS.rpt_executive_v 
WHERE contract_active = 'TRUE'
AND CURRENT_STATUS NOT IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
AND CONTRACT_SIGNED_DATE IS NOT NULL
and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
AND CONTRACT_SIGNED_DATE < DATEADD('month',-2, DATE_TRUNC('month', CURRENT_DATE()))
AND CONTRACT_SIGNED_DATE >= DATEADD('month',-3, DATE_TRUNC('month', CURRENT_DATE()))
GROUP BY PARTNER_NAME, PI_ORG_STATUS
)
, table_A AS(
SELECT CASE WHEN m.partner_name IS NULL THEN pm.PARTNER_NAME ELSE m.partner_name END AS Partner_Name, 
CASE WHEN m.pi_org_status IS NULL THEN pm.pi_org_status ELSE m.pi_org_status END AS PARTNER_STATUS
, MTD_volume, PREV_MONTH_volume, THREE_MONTH_AGO_VOLUME
, MTD_avg_contract_amount,PREV_MONTH_avg_contract_amount
, MTD_FICO, PREV_MONTH_FICO
, MTD_FICO_680, PREV_MONTH_FICO_680
, MTD_ACH_POS,PREV_MONTH_ACH_POS
, MTD_ACH_POS/MTD_volume as MTD_PERCENT_ACH
, PREV_MONTH_ACH_POS/PREV_MONTH_volume as PREV_MONTH_PERCENT_ACH
, MTD_ppw , PREV_MONTH_ppw
, cm.MTD_num_cancelled, cpm.PREV_MONTH_num_cancelled
, cm.MTD_Total_volume , cpm.PREV_MONTH_Total_volume
, m.MTD_DURATION_CONTRACT_TO_NTP
, PREV_MONTH_DURATION_CONTRACT_TO_NTP
FROM MTD m FULL JOIN prev_month pm ON m.partner_name = pm.partner_name
LEFT JOIN Cancellation_MTD cm ON m.partner_name = cm.partner_name
LEFT JOIN Cancellation_prev_Month cpm ON pm.partner_name = cpm.partner_name
LEFT JOIN THREE_MONTH_AGO TM ON m.partner_name = TM.partner_name
--WHERE  M.PARTNER_NAME LIKE 'Our World Energy'
) 
, table_B AS(
SELECT partner_name, PARTNER_STATUS
, COALESCE(MTD_volume,0) AS MTD_volume, COALESCE(PREV_MONTH_volume,0) AS PREV_MONTH_volume,(MTD_volume- PREV_MONTH_volume) AS Delta_Vol , THREE_MONTH_AGO_VOLUME, (COALESCE(PREV_MONTH_volume,0)-COALESCE(THREE_MONTH_AGO_VOLUME,0)) AS DELTA_VOL_3M
, MTD_avg_contract_amount, PREV_MONTH_avg_contract_amount
, COALESCE(MTD_avg_contract_amount,0)-COALESCE(PREV_MONTH_avg_contract_amount,0) as DELTA_CTR_AMT
--, MTD_avg_contract_amount/PREV_MONTH_avg_contract_amount as DELTA_PERCENT_CTR_AMT
, MTD_FICO, PREV_MONTH_FICO, MTD_FICO-PREV_MONTH_FICO AS DELTA_FICO
--, MTD_FICO_680, PREV_MONTH_FICO_680
, MTD_FICO_680/MTD_volume AS MTD_PERCENT_FICO_680
, PREV_MONTH_FICO_680/PREV_MONTH_volume AS PREV_MONTH_PERCENT_FICO_680  
, MTD_PERCENT_FICO_680 - PREV_MONTH_PERCENT_FICO_680 AS DELTA_PERCENT_FICO_680
, MTD_PERCENT_ACH, PREV_MONTH_PERCENT_ACH,  MTD_PERCENT_ACH - PREV_MONTH_PERCENT_ACH AS DELTA_ACH
, MTD_ppw , PREV_MONTH_ppw, MTD_ppw-PREV_MONTH_ppw AS DELTA_PPW
, MTD_num_cancelled, PREV_MONTH_num_cancelled
--, MTD_num_cancelled-PREV_MONTH_num_cancelled AS DELTA_CANCEL
, MTD_Total_volume , PREV_MONTH_Total_volume
, MTD_num_cancelled/MTD_Total_volume AS MTD_PERCENT_CANCEL
, PREV_MONTH_num_cancelled/PREV_MONTH_Total_volume AS PREV_MONTH_PERCENT_CANCEL
, MTD_PERCENT_CANCEL-PREV_MONTH_PERCENT_CANCEL AS DELTA_PERCENT_CANCEL
, MTD_DURATION_CONTRACT_TO_NTP
, PREV_MONTH_DURATION_CONTRACT_TO_NTP
, MTD_DURATION_CONTRACT_TO_NTP - PREV_MONTH_DURATION_CONTRACT_TO_NTP AS DELTA_DURATIONS_CONTRACT_TO_NTP
--, CASE WHEN MTD_FICO < 725 THEN 'risk' else 'in range'  END CTRL_FICO
--, CASE WHEN MTD_PERCENT_CANCEL > 0.35 THEN 'risk' else 'in range'  END CTRL_CANCELLATIONS
FROM table_A
--WHERE PARTNER_NAME LIKE 'Our World Energy'
)
SELECT partner_name
, MTD_volume, PREV_MONTH_volume, Delta_Vol , THREE_MONTH_AGO_VOLUME, DELTA_VOL_3M
, MTD_avg_contract_amount, PREV_MONTH_avg_contract_amount
, DELTA_CTR_AMT
, MTD_FICO, PREV_MONTH_FICO, DELTA_FICO
, MTD_PERCENT_FICO_680, PREV_MONTH_PERCENT_FICO_680, DELTA_PERCENT_FICO_680
, MTD_PERCENT_ACH, PREV_MONTH_PERCENT_ACH, DELTA_ACH
, MTD_ppw , PREV_MONTH_ppw, DELTA_PPW
, MTD_PERCENT_CANCEL,  PREV_MONTH_PERCENT_CANCEL, DELTA_PERCENT_CANCEL
, MTD_DURATION_CONTRACT_TO_NTP, PREV_MONTH_DURATION_CONTRACT_TO_NTP, DELTA_DURATIONS_CONTRACT_TO_NTP
, PARTNER_STATUS
FROM table_B
