select partner_name, PI_ORG_STATUS, APPLICATION_ID , ORIGINAL_CONTRACT_SIGNED_DATE, table_name as Business_Product,  current_status, contract_status, LOAN_AMOUNT AS contract_amount
, highest_fico_score
, CASE WHEN highest_fico_score <680 THEN 1 END FICO_680
,  PAYMENT_OPTION as ACH_POS
, (LOAN_AMOUNT/(SYSTEM_SIZE*1000)) as ppw
, CASE WHEN TABLE_NAME = 'TPO' AND NOTICE_TO_PROCEED_TIMESTAMP IS NULL THEN DATEDIFF('DAY',ORIGINAL_CONTRACT_SIGNED_DATE, CURRENT_DATE()) END   AS DURATION_CONTRACT_TO_NTP
FROM  PRD_BI.LOS.rpt_executive_v 
WHERE 
contract_active = 'TRUE'
AND CURRENT_STATUS NOT IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
AND CONTRACT_SIGNED_DATE IS NOT NULL
and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
AND ORIGINAL_CONTRACT_SIGNED_DATE >= DATE_TRUNC('month',CURRENT_DATE()) 
