/* describe view --PRD_BI.LOS.RPT_SERVICING_V --PRD_BI.LOS.RPT_OPERATIONS_V   --
--PRD_BI.LOS.RPT_TASKS_V --
 PRD_BI.LOS.rpt_executive_v
  describe view PRD_BI.LOS.RPT_SALES_REPS_V
  describe view PRD_BI.LOS.RPT_TASKS_V 
*/ 
-- INCLUDE Salesrep that submit an application in the last 90 days
-- Only for Active Partners
WITH SALESREP AS (
 SELECT DISTINCT SALESPERSON_NAME, SALESPERSON_EMAIL, PARTNER_NAME--, PI_ORG_STATUS
 FROM  PRD_BI.LOS.rpt_executive_v
 WHERE PI_ORG_STATUS NOT IN ('Deactivated', 'Suspended')
 AND DATEDIFF('day',new_credit_application_timestamp,CURRENT_DATE() ) <=90
)
, ACTIVE_SALESREP AS(
SELECT DISTINCT W.SALESPERSON_NAME,  W.PARTNER_NAME --W.SALESPERSON_EMAIL,
--, S.SALESPERSON_DEACTIVATION_DATE, PI_STAFF_SUSPENSION_DATE, PI_STAFF_SUSPENSION_REASON , user_active, CASE WHEN S.SALESPERSON_DEACTIVATION_DATE IS NULL AND PI_STAFF_SUSPENSION_DATE IS NULL AND user_active = 'TRUE' THEN 'ACTIVE' ELSE 'DEACTIVATED/SUSPENDED' END AS IS_ACTIVE
FROM  SALESREP W LEFT JOIN PRD_BI.LOS.RPT_SALES_REPS_V S ON 
w.SALESPERSON_NAME = S.FULL_NAME AND W.SALESPERSON_EMAIL = S.EMAIL
AND  W.PARTNER_NAME = S.PARTNER_ORGANIZATION_NAME 
WHERE SALESPERSON_DEACTIVATION_DATE IS NULL AND PI_STAFF_SUSPENSION_DATE IS NULL AND user_active = 'TRUE'

)
, EXEC AS(
select SALESPERSON_NAME,  PARTNER_NAME  --, CONTRACT_ID, SALESPERSON_EMAIL,
, COUNT(CONTRACT_ID) AS TOT_CTR_VOL
, AVG((LOAN_AMOUNT/(SYSTEM_SIZE*1000))) as ppw
, AVG( CASE WHEN PROJECT_TYPE = 'SolarSystem' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/6.5
WHEN PROJECT_TYPE = 'SolarSystemBatteryStorage' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/10
WHEN PROJECT_TYPE = 'SolarSystemReroofing' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/12
WHEN PROJECT_TYPE = 'SolarSystemGroundMount' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/12
WHEN PROJECT_TYPE = 'SolarSystemBatteryStorageReroofing' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/15
WHEN PROJECT_TYPE = 'SolarSystemBatteryStorageReroofingge' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/15
WHEN PROJECT_TYPE = 'SolarSystemBatteryStorageGroundMount' THEN (LOAN_AMOUNT/(SYSTEM_SIZE*1000))/15
END) ppw_by_cap
, COUNT(CASE WHEN payment_option = 'ACH' AND  TRUE THEN APPLICATION_ID END ) ACH_POS
, AVG(BORROWER_AGE) AVG_APP_AGE
FROM PRD_BI.LOS.rpt_executive_v
WHERE PI_ORG_STATUS NOT IN ('Deactivated', 'Suspended') AND
contract_active = 'TRUE'AND CURRENT_STATUS NOT IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') AND CONTRACT_SIGNED_DATE IS NOT NULL
and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED') 
GROUP BY SALESPERSON_NAME, PARTNER_NAME
)
, SERVICING AS( 
SELECT PARTNER_NAME, SALESPERSON_FULL_NAME
, COUNT(ACCOUNT_NUMBER) AS CTR_IN_SERVICING
, COUNT(CASE WHEN CURRENT_STATUS IN ('REPAY','DEFER') AND DAYS_DELINQUENT_GROUP IN ('1-30') THEN ACCOUNT_NUMBER END) AS DQ_1_30
, COUNT(CASE WHEN CURRENT_STATUS IN ('REPAY','DEFER') AND DAYS_DELINQUENT_GROUP IN ('31-60','61-90') THEN ACCOUNT_NUMBER END) AS DQ_31_90
, COUNT(CASE WHEN CURRENT_STATUS IN ('REPAY','DEFER', 'PBC','DEFAULT') AND DAYS_DELINQUENT_GROUP IN ('91-120','121+') THEN ACCOUNT_NUMBER END) AS DQ_91
, COUNT(CASE WHEN ACH IN ('ACTIVE', 'PEND')  THEN ACCOUNT_NUMBER END) AS ACH_SERV 
FROM PRD_BI.LOS.RPT_SERVICING_V
WHERE AS_OF_DATE = DATEADD('DAY', -1, CURRENT_DATE())
GROUP BY PARTNER_NAME, SALESPERSON_FULL_NAME

)
, CANCELLATION AS(
select SALESPERSON_NAME, PARTNER_NAME
, COUNT(CASE WHEN PROJECT_CANCELLED_TIMESTAMP IS NOT NULL 
AND CURRENT_STATUS IN('PROJECT CANCELLED','SIGNED CONTRACT CANCELLED','CREDIT DECLINED','INACTIVE PROJECT') 
THEN 1 END) AS num_cancelled
, COUNT(APPLICATION_ID) AS ALL_CTR_VOL
FROM  PRD_BI.LOS.rpt_executive_v
WHERE contract_active = 'TRUE'
AND CONTRACT_SIGNED_DATE IS NOT NULL 
--AND ORIGINAL_CONTRACT_SIGNED_DATE >= DATE_TRUNC('month',CURRENT_DATE()) 
--and CONTRACT_status in ('NEW - ENTERED','CONTRACT SIGNED')
GROUP BY PARTNER_NAME, SALESPERSON_NAME
)
,COMPLAINTS AS(
SELECT PARTNER_NAME, SALESPERSON_NAME 
, COUNT( CASE WHEN REC_TYPE IN('Bounced AAN') THEN TASK_ID END) BOUNCED_AAN
, COUNT(CASE WHEN REC_TYPE IN ('Complaint') AND Category NOT IN ('Workmanship') THEN CONTRACT_ID_ORIG END) TOT_COMPLAINTS
FROM PRD_BI.LOS.RPT_TASKS_V 
WHERE REC_TYPE IN ('Bounced AAN', 'Complaint')
GROUP BY  PARTNER_NAME, SALESPERSON_NAME 
)
, CONSOLIDATION_DATA AS (
SELECT S.PARTNER_NAME, S.SALESPERSON_NAME,  COALESCE(E.TOT_CTR_VOL,0) AS TOT_CTR_VOL, E.ppw, E.ppw_by_cap
, COALESCE(CO.BOUNCED_AAN,0) AS BOUNCED_AAN
, CASE WHEN COALESCE(E.TOT_CTR_VOL,0) != 0 THEN CO.BOUNCED_AAN/E.TOT_CTR_VOL
       WHEN COALESCE(CO.BOUNCED_AAN,0) != 0 THEN 1
        ELSE 0  END AS PERCENT_BOUNCED_AAN
, E.ACH_POS, SR.ACH_SERV
, CASE WHEN COALESCE(E.ACH_POS,0) != 0 THEN COALESCE(SR.ACH_SERV,0)/E.ACH_POS
       WHEN COALESCE(SR.ACH_SERV,0) != 0 THEN 1
        ELSE 0  END AS PERCENT_ACH
, COALESCE(E.AVG_APP_AGE,0) AVG_APP_AGE
, COALESCE(SR.CTR_IN_SERVICING,0) AS CTR_IN_SERVICING
, SR.DQ_1_30
, CASE WHEN COALESCE(SR.CTR_IN_SERVICING,0) != 0 THEN COALESCE(SR.DQ_1_30,0)/SR.CTR_IN_SERVICING
       WHEN COALESCE(SR.DQ_1_30,0) != 0 THEN 1
        ELSE 0  END AS PERCENT_DQ_1_30
, SR.DQ_31_90
, CASE WHEN COALESCE(SR.CTR_IN_SERVICING,0) != 0 THEN COALESCE(SR.DQ_31_90,0)/SR.CTR_IN_SERVICING
       WHEN COALESCE(SR.DQ_31_90,0) != 0 THEN 1
        ELSE 0  END AS PERCENT_DQ_31_90
, SR.DQ_91 
, CASE WHEN COALESCE(SR.CTR_IN_SERVICING,0) != 0 THEN COALESCE(SR.DQ_91,0)/SR.CTR_IN_SERVICING
       WHEN COALESCE(SR.DQ_91,0) != 0 THEN 1
        ELSE 0  END AS PERCENT_DQ_91
, COALESCE(C.num_cancelled,0) AS num_cancelled, COALESCE(C.ALL_CTR_VOL,0) AS ALL_CTR_VOL
, C.num_cancelled/C.ALL_CTR_VOL AS PERCENT_CANCEL
, COALESCE(CO.TOT_COMPLAINTS,0) AS TOT_COMPLAINTS
, CASE WHEN COALESCE(E.TOT_CTR_VOL,0) != 0 THEN CO.TOT_COMPLAINTS/E.TOT_CTR_VOL
        WHEN COALESCE(CO.TOT_COMPLAINTS,0) != 0 THEN 1
        ELSE 0  END AS PERCENT_COMPLAINTS_BY_CTR_VOL, 
FROM ACTIVE_SALESREP S LEFT JOIN EXEC E
ON S.PARTNER_NAME = E.PARTNER_NAME AND S.SALESPERSON_NAME = E.SALESPERSON_NAME
LEFT JOIN SERVICING SR 
ON S.PARTNER_NAME = SR.PARTNER_NAME AND S.SALESPERSON_NAME = SR.SALESPERSON_FULL_NAME
LEFT JOIN CANCELLATION C
ON S.PARTNER_NAME = C.PARTNER_NAME AND S.SALESPERSON_NAME = C.SALESPERSON_NAME
LEFT JOIN COMPLAINTS CO
ON S.PARTNER_NAME = CO.PARTNER_NAME AND S.SALESPERSON_NAME = CO.SALESPERSON_NAME  
)
, CALC AS(
SELECT PARTNER_NAME, SALESPERSON_NAME
, TOT_CTR_VOL, CTR_IN_SERVICING, ppw, ppw_by_cap
, CASE WHEN ppw_by_cap < 0.5 THEN 100
       WHEN  ppw_by_cap >=0.50 and  ppw_by_cap <75 THEN 50
       WHEN  ppw_by_cap >=0.75 THEN 0 ELSE 0 END AS SCORE_PPW
, TOT_COMPLAINTS , PERCENT_COMPLAINTS_BY_CTR_VOL
, CASE WHEN COALESCE(TOT_COMPLAINTS,0) = 0 THEN 100
       WHEN PERCENT_COMPLAINTS_BY_CTR_VOL <=0.03 THEN 100
       WHEN PERCENT_COMPLAINTS_BY_CTR_VOL<0.1 AND PERCENT_COMPLAINTS_BY_CTR_VOL > 0.03 THEN 50
       WHEN PERCENT_COMPLAINTS_BY_CTR_VOL>=0.1 THEN 0
       WHEN COALESCE(TOT_CTR_VOL,0) = 0 THEN 0
       
    END AS SCORE_COMPLAINTS
, ACH_POS, ACH_SERV, PERCENT_ACH
, CASE WHEN CTR_IN_SERVICING = 0 THEN 50
       WHEN PERCENT_ACH >=1 THEN 100
       WHEN PERCENT_ACH <1 AND PERCENT_ACH > 0.8 THEN 50
       WHEN PERCENT_ACH <=0.8 THEN 0 ELSE 50 END AS SCORE_ACH
, BOUNCED_AAN, PERCENT_BOUNCED_AAN
, CASE WHEN BOUNCED_AAN = 0 THEN 100
       WHEN PERCENT_BOUNCED_AAN <=0.05 THEN 100
       WHEN PERCENT_BOUNCED_AAN >0.05 AND PERCENT_BOUNCED_AAN < 0.15 THEN 50
       WHEN PERCENT_BOUNCED_AAN >= 0.15 THEN 0 END SCORE_BOUNCED_ANN
,DQ_1_30, PERCENT_DQ_1_30
, CASE WHEN CTR_IN_SERVICING = 0 THEN 85
        WHEN PERCENT_DQ_1_30 <=0.02 THEN 100
        WHEN PERCENT_DQ_1_30 >0.02 AND PERCENT_DQ_1_30 <0.1 THEN 50
        WHEN PERCENT_DQ_1_30 >=0.1 THEN 0
        END AS SCORE_DQ_1_30
, DQ_31_90, PERCENT_DQ_31_90
, CASE WHEN CTR_IN_SERVICING = 0 THEN 85
        WHEN PERCENT_DQ_31_90 <=0.02 THEN 100
        WHEN PERCENT_DQ_31_90 >0.02 AND PERCENT_DQ_31_90 <0.1 THEN 50
        WHEN PERCENT_DQ_31_90 >=0.1 THEN 0
        END AS SCORE_DQ_31_90
, DQ_91, PERCENT_DQ_91
, CASE WHEN CTR_IN_SERVICING = 0 THEN 85
        WHEN PERCENT_DQ_91 <=0.02 THEN 100
        WHEN PERCENT_DQ_91 >0.02 AND PERCENT_DQ_91 <0.1 THEN 50
        WHEN PERCENT_DQ_91 >=0.1 THEN 0
        END AS SCORE_DQ_91
, COALESCE(num_cancelled,0) AS NUM_CANCELLED, ALL_CTR_VOL, PERCENT_CANCEL
, CASE WHEN  PERCENT_CANCEL <0.10 THEN 100
        WHEN PERCENT_CANCEL >=0.10 AND PERCENT_CANCEL <0.2 THEN 50
        WHEN PERCENT_CANCEL >=0.2 THEN 0
        WHEN NUM_CANCELLED = 0 THEN 100 
        END AS SCORE_CANCELLATIONS
, AVG_APP_AGE
, CASE WHEN AVG_APP_AGE =0 THEN 50  --- WHEN THERE IS NO AGE
        WHEN AVG_APP_AGE <65 THEN 100
        WHEN AVG_APP_AGE >=65 AND AVG_APP_AGE <80 THEN 50
        WHEN AVG_APP_AGE  >=80 THEN 0
        END AS SCORE_AGE
, 0.10*SCORE_PPW + 0.15*SCORE_COMPLAINTS + 0.15*SCORE_ACH + 0.1*SCORE_BOUNCED_ANN + 0.05*SCORE_DQ_1_30 + 0.1*SCORE_DQ_31_90 + 0.1*SCORE_DQ_91 + 0.1*SCORE_CANCELLATIONS + 0.15* SCORE_AGE as TOTAL_POINTS
, CASE WHEN TOTAL_POINTS >= 90 then 'A'
        WHEN TOTAL_POINTS >=80 AND TOTAL_POINTS <90 then 'B'
        WHEN TOTAL_POINTS >=70 AND TOTAL_POINTS <80 THEN 'C'
        WHEN TOTAL_POINTS >=60 AND TOTAL_POINTS <70 THEN 'D'
        WHEN TOTAL_POINTS <60 THEN	'F'
        END AS GRADE

FROM CONSOLIDATION_DATA)



SELECT
PARTNER_NAME,	SALESPERSON_NAME,	GRADE,	TOTAL_POINTS,	TOT_CTR_VOL,	CTR_IN_SERVICING,	PPW,	PPW_BY_CAP,	SCORE_PPW,	TOT_COMPLAINTS,	PERCENT_COMPLAINTS_BY_CTR_VOL,	SCORE_COMPLAINTS,	ACH_POS,	ACH_SERV,	PERCENT_ACH,	SCORE_ACH,	BOUNCED_AAN,	PERCENT_BOUNCED_AAN,	SCORE_BOUNCED_ANN,	DQ_1_30,	PERCENT_DQ_1_30,	SCORE_DQ_1_30,	DQ_31_90,	PERCENT_DQ_31_90,	SCORE_DQ_31_90,	DQ_91,	PERCENT_DQ_91,	SCORE_DQ_91,	NUM_CANCELLED,	ALL_CTR_VOL,	PERCENT_CANCEL, SCORE_CANCELLATIONS,	AVG_APP_AGE,	SCORE_AGE
FROM CALC
